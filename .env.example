# Leave all keys empty to run in offline mode.
# anthropic | openai | offline (default: picked from whichever key is set)
LLM_PROVIDER=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Langfuse tracing (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Limits
RETRIEVAL_TOP_K=4
SQL_ROW_LIMIT=50
MAX_TOOL_STEPS=6
MAX_WRITE_ATTEMPTS=2
